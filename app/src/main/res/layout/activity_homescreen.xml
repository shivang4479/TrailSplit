<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".Homescreen"
    android:background="@color/white">

    <TextView
        android:id="@+id/greeting"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Hello 👋"
        android:textSize="40dp"
        android:layout_marginLeft="15dp"
        android:layout_marginTop="8dp"
        android:textColor="@color/black"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        />
    <ImageButton
        android:id="@+id/notificationIcon"
        android:layout_width="55dp"
        android:layout_height="55dp"
        android:src="@drawable/ic_notifications"
        android:background="@android:color/transparent"
        android:contentDescription="Notification"
        app:tint="#008F5A"
        android:padding="10dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginRight="15dp"

        />
    <TextView
        android:id="@+id/trip_id"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Current Trip"
        android:textSize="25dp"
       android:layout_marginTop="15dp"
        android:textColor="@color/black"
        app:layout_constraintTop_toBottomOf="@id/greeting"
        app:layout_constraintStart_toStartOf="@id/greeting"
        />


  <!-- Card Code -->

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/currentTripCard"
        android:layout_height="120dp"
        android:layout_width="0dp"
        android:layout_marginStart="15dp"
        android:layout_marginTop="15dp"
        android:layout_marginEnd="15dp"
        app:cardCornerRadius="18dp"
        android:elevation="3dp"
        app:cardBackgroundColor="#DDF3ED"
        app:layout_constraintTop_toBottomOf="@id/trip_id"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        >

        <!-- Card inside things-->




        ></com.google.android.material.card.MaterialCardView>
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/Expensesumaarycard"
        android:layout_height="120dp"
        android:layout_width="0dp"
        android:layout_marginStart="15dp"
        android:layout_marginTop="15dp"
        android:layout_marginEnd="15dp"
        app:cardCornerRadius="18dp"
        android:elevation="3dp"
        app:cardBackgroundColor="#DDF3ED"
        app:layout_constraintTop_toBottomOf="@id/currentTripCard"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        >

        <!-- Card inside things-->




        ></com.google.android.material.card.MaterialCardView>
<androidx.recyclerview.widget.RecyclerView
    android:id="@+id/expenserecycler"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    app:layout_constraintTop_toBottomOf="@id/Expensesumaarycard"
    app:layout_constraintStart_toStartOf="@id/Expensesumaarycard"
    app:layout_constraintEnd_toEndOf="@id/Expensesumaarycard"
    />









    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottom_nav"
        android:layout_width="match_parent"
        android:layout_height="80dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:menu="@menu/bottom_nav_menu"


        />












</androidx.constraintlayout.widget.ConstraintLayout>
