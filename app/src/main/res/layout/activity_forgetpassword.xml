<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    tools:context=".Forgetpassword">


    <ImageView
        android:id="@+id/forget"
        android:layout_width="0dp"
        android:layout_height="300dp"
        android:scaleType="fitXY"
        android:src="@drawable/forget"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:contentDescription="@null"/>

    <TextView
        android:id="@+id/forgotpassword"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Forgot Password?"
        android:layout_marginTop="12dp"
        android:textColor="@color/black"
        android:textSize="32sp"
        app:layout_constraintTop_toBottomOf="@id/forget"
        app:layout_constraintStart_toStartOf="@id/forget"
        android:paddingLeft="15dp"
        />

    <TextView
        android:id="@+id/forgotstatement"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="No worries! Enter your registered email and we'll send you a link to reset your password"
        android:textColor="@color/black"
        android:layout_marginTop="12dp"
        android:textSize="19sp"
        android:paddingLeft="15dp"
        app:layout_constraintTop_toBottomOf="@id/forgotpassword"
        app:layout_constraintStart_toStartOf="@id/forgotpassword"/>

    <EditText
        android:id="@+id/forgotemail"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Email"
        android:textColorHint="@color/cardview_dark_background"
        android:paddingStart="25dp"
android:layout_marginTop="20dp"
        android:textSize="22sp"
        android:paddingTop="20dp"
        android:paddingLeft="15dp"
        app:layout_constraintTop_toBottomOf="@id/forgotstatement"
        app:layout_constraintStart_toStartOf="@id/forgotstatement"
/>

    <Button
        android:id="@+id/forgotbtn"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Send Reset Link"
        android:textSize="20sp"
        android:layout_marginTop="30dp"
        app:layout_constraintStart_toStartOf="@id/forgotemail"
        app:layout_constraintEnd_toEndOf="@id/forgotemail"
        app:layout_constraintTop_toBottomOf="@id/forgotemail"
        />

    <TextView
        android:id="@+id/forgotremember"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Remember your password?"
        android:textSize="16dp"
        android:textColor="@color/black"
        android:paddingTop="20dp"
        app:layout_constraintTop_toBottomOf="@id/forgotbtn"
        android:paddingLeft="95dp"
        app:layout_constraintStart_toStartOf="parent"

        />


    <TextView
        android:id="@+id/backtologin"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Login"
        android:textSize="18dp"

        app:layout_constraintStart_toEndOf="@id/forgotremember"
        app:layout_constraintTop_toBottomOf="@id/forgotbtn"
        android:paddingTop="20dp"
        android:paddingLeft="12dp"
        android:textColor="#2196F3"
        />

</androidx.constraintlayout.widget.ConstraintLayout>