<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".CreateTripscreen"
    android:background="@color/white">

    <ImageButton
        android:id="@+id/backbtn"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginStart="0dp"
        android:layout_marginTop="16dp"
        android:background="@android:color/transparent"
        android:src="@drawable/ic_arrow_back"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:paddingTop="20dp"
        />

    <TextView
        android:id="@+id/CNTTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Create New Trip"
        android:layout_marginStart="16dp"
        android:textSize="30dp"
        app:layout_constraintStart_toEndOf="@id/backbtn"
        android:paddingTop="20dp"
        android:textColor="@color/black"

        app:layout_constraintTop_toTopOf="@+id/backbtn"
        app:layout_constraintBottom_toBottomOf="@+id/backbtn"

        />
    <ImageView
        android:id="@+id/tripimage"
        android:layout_width="110dp"
        android:layout_height="110dp"
        android:layout_marginTop="24dp"
        android:src="@drawable/ic_cammera"
        android:background="@drawable/circle_background"
        android:padding="30dp"
        app:layout_constraintTop_toBottomOf="@+id/CNTTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <TextView
        android:id="@+id/tripname"
        android:layout_width="0dp"
        android:layout_height="20dp"
        android:text="Trip Name"
        android:textSize="16dp"
        android:paddingLeft="20dp"
        android:textColor="@color/black"
        android:layout_marginTop="10dp"


        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tripimage" />

    <EditText
        android:id="@+id/entertripname"
        android:layout_width="0dp"
        android:layout_height="50dp"
        android:hint="Enter Trip Name"
        android:textColor="@color/gray"
        android:textColorHint="@color/lightgray"
        android:background="@drawable/edittext_background"
        android:padding="12dp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:inputType="text"
        android:layout_marginTop="11dp"
        app:layout_constraintTop_toBottomOf="@id/tripname"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        />

    <TextView
        android:id="@+id/destination"
        android:layout_width="0dp"
        android:layout_height="20dp"
        android:text="Destination"
        android:textSize="16dp"
        android:textColor="@color/black"
        android:paddingLeft="20dp"
        android:layout_marginTop="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/entertripname" />

    <EditText
        android:id="@+id/enterdestination"
        android:layout_width="0dp"
        android:layout_height="50dp"
        android:hint="Enter Destination"
        android:textColorHint="@color/lightgray"
        android:textColor="@color/black"
        android:background="@drawable/edittext_background"
        android:padding="12dp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:inputType="text"
        android:layout_marginTop="11dp"
        app:layout_constraintTop_toBottomOf="@id/destination"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        />

    <TextView
        android:id="@+id/startdate"
        android:layout_width="0dp"
        android:layout_height="20dp"
        android:text="Start Date"
        android:textSize="16dp"
        android:textColor="@color/black"
        android:paddingLeft="20dp"
        android:layout_marginTop="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/enterdestination" />

    <EditText
        android:id="@+id/enterstartdate"
        android:layout_width="0dp"
        android:layout_height="50dp"
        android:hint="Enter Start date"
        android:textColor="@color/gray"
        android:textColorHint="@color/lightgray"
        android:focusable="false"
        android:clickable="true"
        android:background="@drawable/edittext_background"
        android:padding="12dp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:inputType="text"
        android:layout_marginTop="11dp"
        app:layout_constraintTop_toBottomOf="@id/startdate"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        />

    <TextView
        android:id="@+id/enddate"
        android:layout_width="0dp"
        android:layout_height="20dp"
        android:text="End Date"
        android:textSize="16dp"
        android:paddingLeft="20dp"
        android:layout_marginTop="16dp"
        android:textColor="@color/black"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/enterstartdate" />

    <EditText
        android:id="@+id/enterenddate"
        android:layout_width="0dp"
        android:layout_height="50dp"
        android:hint="Enter End date"
        android:textColorHint="@color/lightgray"
        android:textColor="@color/gray"
        android:focusable="false"
        android:clickable="true"
        android:background="@drawable/edittext_background"
        android:padding="12dp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:inputType="text"
        android:layout_marginTop="11dp"
        app:layout_constraintTop_toBottomOf="@id/enddate"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        />

    <!--    Changes to be made in Invite member section-->

    <TextView
        android:id="@+id/invitemember"
        android:layout_width="0dp"
        android:layout_height="20dp"
        android:text="Invite Member"
        android:textSize="16dp"
        android:paddingLeft="20dp"
        android:layout_marginTop="16dp"
        android:textColor="@color/black"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/enterenddate" />

    <ImageButton
        android:id="@+id/addmember"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"
        android:background="@android:color/transparent"
        android:src="@drawable/add_ic"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/invitemember"
        />

    <Button
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Create Trip"
        android:textSize="20sp"
        android:layout_marginTop="20dp"
        app:layout_constraintTop_toBottomOf="@+id/addmember"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

    </Button>










</androidx.constraintlayout.widget.ConstraintLayout>