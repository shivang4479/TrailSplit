<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white">

    <TextView
        android:id="@+id/addExpenseTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Add Expense"
        android:textSize="28sp"
        android:textStyle="bold"
        android:textColor="@color/black"
        android:layout_marginStart="20dp"
        android:layout_marginTop="10dp"
        app:layout_constraintTop_toTopOf="parent"
        android:paddingLeft="82dp"

        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/expensename"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@id/addExpenseTitle"
        app:layout_constraintStart_toStartOf="@id/addExpenseTitle"
        android:textColor="@color/black"
        android:text="Expense Name"
        android:textSize="16dp"
        android:layout_marginTop="15dp"/>


    <EditText
        android:id="@+id/expenseNameInput"
        android:layout_width="0dp"
        android:layout_height="45dp"
        android:hint="Expense Name"
        android:textColorHint="@color/lightgray"
        android:paddingLeft="10dp"

        android:inputType="text"
        android:textSize="16dp"
android:background="@drawable/edittext_background"

        android:layout_marginEnd="18dp"
        android:layout_marginTop="8dp"

        app:layout_constraintTop_toBottomOf="@id/expensename"
        app:layout_constraintStart_toStartOf="@id/expensename"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/expensecost"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@id/expenseNameInput"
        app:layout_constraintStart_toStartOf="@id/expensename"
        android:textColor="@color/black"
        android:text="Expense Cost"
        android:textSize="16dp"
        android:layout_marginTop="8dp"/>



    <EditText
        android:id="@+id/expenseCostInput"
        android:layout_width="0dp"
        android:layout_height="45dp"
        android:hint="Expense Cost"
        android:inputType="numberDecimal"
        android:textSize="16dp"
        android:background="@drawable/edittext_background"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="18dp"
        android:paddingLeft="10dp"
        android:textColorHint="@color/lightgray"

        app:layout_constraintTop_toBottomOf="@id/expensecost"
        app:layout_constraintStart_toStartOf="@id/expensecost"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/category"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@+id/expenseCostInput"
        app:layout_constraintStart_toStartOf="@id/expensename"
        android:textColor="@color/black"
        android:text="Category"
        android:textSize="16dp"
        android:layout_marginTop="8dp"/>

<com.google.android.material.textfield.TextInputLayout
    android:id="@+id/categorysection"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:layout_constraintTop_toBottomOf="@id/category"
    app:layout_constraintStart_toStartOf="@id/category"
    android:hint="Category"
    android:textColorHint="@color/lightgray"
    app:boxCornerRadiusBottomEnd="10dp"
    app:boxCornerRadiusBottomStart="10dp"
    app:boxCornerRadiusTopEnd="10dp"
    app:boxCornerRadiusTopStart="10dp"
    android:layout_marginTop="8dp"
    app:boxStrokeColor="@color/cardview_light_background"
    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
    >
    <AutoCompleteTextView
        android:id="@+id/dropdowncategory"
        android:layout_width="match_parent"
        android:layout_height="45dp"
        android:layout_marginStart="18dp"
        android:layout_marginEnd="18dp"
        android:focusable="false"
        android:clickable="true"

        android:dropDownHeight="250dp"

        app:layout_constraintTop_toBottomOf="@id/categorysection"
        android:inputType="none"/>
</com.google.android.material.textfield.TextInputLayout>

    <TextView
        android:id="@+id/paid"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Paid By"
        android:textSize="16dp"
        android:textColor="@color/black"
        app:layout_constraintStart_toStartOf="@id/category"
        app:layout_constraintTop_toBottomOf="@id/categorysection"
        android:layout_marginTop="8dp"
        />

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/paidby"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@id/paid"
        app:layout_constraintStart_toStartOf="@+id/paid"
        android:hint="Paid By"
        android:textColorHint="@color/lightgray"
        android:layout_marginTop="8dp"

        app:boxCornerRadiusBottomEnd="10dp"
        app:boxCornerRadiusBottomStart="10dp"
        app:boxCornerRadiusTopEnd="10dp"
        app:boxCornerRadiusTopStart="10dp"
        app:boxStrokeColor="@color/cardview_light_background"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
        >
        <AutoCompleteTextView
            android:layout_width="match_parent"
            android:layout_height="45dp"
            android:layout_marginStart="18dp"
            android:layout_marginEnd="18dp"
            android:focusable="false"
            android:clickable="true"
            android:dropDownHeight="250dp"/>

    </com.google.android.material.textfield.TextInputLayout>

    <TextView
        android:id="@+id/split"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Split Between"
        android:textSize="16dp"
        android:textColor="@color/black"
        app:layout_constraintStart_toStartOf="@id/category"
        app:layout_constraintTop_toBottomOf="@id/paidby"
        android:layout_marginTop="8dp"
        />

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/split_bw"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@id/split"
        app:layout_constraintStart_toStartOf="@+id/paid"
        android:hint="Split"
        android:textColorHint="@color/lightgray"
        android:layout_marginTop="8dp"

        app:boxCornerRadiusBottomEnd="10dp"
        app:boxCornerRadiusBottomStart="10dp"
        app:boxCornerRadiusTopEnd="10dp"
        app:boxCornerRadiusTopStart="10dp"

        app:boxStrokeColor="@color/cardview_light_background"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
        >
        <AutoCompleteTextView
            android:layout_width="match_parent"
            android:layout_height="45dp"
            android:layout_marginStart="18dp"
            android:layout_marginEnd="18dp"
            android:focusable="false"
            android:clickable="true"
            android:dropDownHeight="250dp"/>
    </com.google.android.material.textfield.TextInputLayout>

    <TextView
        android:id="@+id/date"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Date"
        android:textSize="16dp"
        android:textColor="@color/black"
        app:layout_constraintStart_toStartOf="@id/category"
        app:layout_constraintTop_toBottomOf="@id/split_bw"
        android:layout_marginTop="8dp"
        />






    <EditText
        android:id="@+id/expenseDateInput"
        android:layout_width="0dp"
        android:layout_height="45dp"
        android:hint="Expense Date"
        android:textColorHint="@color/lightgray"
        android:focusable="false"
        android:clickable="true"
        android:background="@drawable/edittext_background"
        android:layout_marginTop="8dp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:paddingLeft="15dp"

        app:layout_constraintTop_toBottomOf="@id/date"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <ImageView
        android:id="@+id/calndr"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="@id/expenseDateInput"
        android:src="@drawable/calendar_ic"
        android:paddingRight="10dp"
        android:background="@android:color/transparent"
        app:layout_constraintTop_toBottomOf="@id/date"
        android:layout_marginTop="18dp"/>
    <TextView
        android:id="@+id/location"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Location"
        android:textSize="16dp"
        android:textColor="@color/black"
        app:layout_constraintStart_toStartOf="@id/category"
        app:layout_constraintTop_toBottomOf="@id/expenseDateInput"
        android:layout_marginTop="8dp"
        />







    <EditText
        android:id="@+id/locationinput"
        android:layout_width="0dp"
        android:layout_height="45dp"
        android:hint="Location "
        android:textColorHint="@color/lightgray"

        android:background="@drawable/edittext_background"
        android:layout_marginTop="8dp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:paddingLeft="15dp"

        app:layout_constraintTop_toBottomOf="@id/location"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <ImageView
        android:id="@+id/locationpin"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="@id/expenseDateInput"
        android:src="@drawable/location_pin_ic"
        android:paddingRight="10dp"
        android:background="@android:color/transparent"
        app:layout_constraintTop_toBottomOf="@id/location"


        android:layout_marginTop="18dp"/>






    <EditText
        android:id="@+id/addrecepit"
        android:layout_width="0dp"
        android:layout_height="45dp"
        android:hint="Add receipt"
        android:textColorHint="@color/lightgray"
        android:focusable="false"
        android:clickable="true"
        android:background="@drawable/edittext_background"
        android:layout_marginTop="8dp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:paddingLeft="15dp"

        app:layout_constraintTop_toBottomOf="@id/locationinput"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />
    <ImageView
        android:id="@+id/camera_ic"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="@id/addrecepit"
        android:src="@drawable/ic_cammera"
        android:paddingRight="10dp"
        android:background="@android:color/transparent"
        app:layout_constraintTop_toBottomOf="@id/locationinput"


        android:layout_marginTop="18dp"/>

    <Button
        android:id="@+id/saveExpenseButton"
        android:layout_width="0dp"
        android:layout_height="55dp"
        android:text="Add Expense"
        android:textSize="17sp"
        android:textStyle="bold"
        android:textColor="@color/white"
        android:backgroundTint="#008F5A"
        android:layout_margin="20dp"
     app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>